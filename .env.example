# AWS (use one of: profile, or access key + secret)
AWS_PROFILE=default
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# S3 (overrides in config.py; optional if using defaults)
# PRISM_REGION=us-east-1
# PRISM_BUCKET_LANDING=prism-landing
# PRISM_BUCKET_PROCESSED=prism-processed
# PRISM_BUCKET_MODELS=prism-model-collection

# dask
PRSIM_DASK_WORKER_COUNT=4
PRSIM_DASK_THREADS_PER_WORKER=2
PRSIM_DASK_DASHBOARD_ADDRESS=:8787

# MLflow (for later phases)
# MLFLOW_TRACKING_URI=http://127.0.0.1:5000
